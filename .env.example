# DeepSeek API Key
DEEPSEEK_API_KEY=sk-your-api-key-here

# Optional: DeepSeek Base URL override
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional: API protocol (messages | chat-completions)
# DEEPSEEK_PROTOCOL=messages

# Optional: Default model
# DEEPSEEK_MODEL=deepseek-v4-pro

# Optional: Custom model catalog supplied by BYOK clients (JSON array)
# DEEPSEEK_MODELS_JSON=[{"id":"vendor/model","name":"Custom model","contextWindow":131072}]

# Optional: Permission Mode (workspace-write | danger-full-access)
# DSH_PERMISSION_MODE=workspace-write

# Optional: Sessions Persistence Directory
# DSH_SESSIONS_ROOT=./.sessions
