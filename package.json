{
  "name": "deepseek-harness-acp",
  "version": "0.1.0",
  "description": "Standalone Agent Client Protocol (ACP) server for DeepSeek Harness with real-time streaming, thought visibility, tool lifecycle updates, and session recovery.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "deepseek-harness-acp": "lib/bin.js",
    "dsh-acp": "lib/bin.js"
  },
  "files": [
    "lib",
    "assets",
    "README.md",
    "README.zh.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node lib/bin.js",
    "dev": "tsx src/bin.ts",
    "test": "vitest run",
    "release": "node scripts/release.js",
    "release:patch": "node scripts/release.js patch",
    "release:minor": "node scripts/release.js minor",
    "release:major": "node scripts/release.js major"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "acp",
    "agent-client-protocol",
    "ai-agent",
    "streaming",
    "reasoning"
