{
  "name": "deepseek-harness-acp",
  "version": "0.1.28",
  "description": "Standalone Agent Client Protocol (ACP) server for DeepSeek Harness with real-time streaming, thought visibility, tool lifecycle updates, and session recovery.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./*": "./lib/*.js"
  },
  "bin": {
    "deepseek-harness-acp": "lib/bin.js",
    "dsh-acp": "lib/bin.js"
  },
  "files": [
    "lib",
    "assets",
    "README.md",
    "README.zh.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "start": "node lib/bin.js",
    "dev": "tsx src/bin.ts",
    "pretest": "npm run build",
    "test": "vitest run",
    "release": "node scripts/release.js",
    "release:patch": "node scripts/release.js patch",
    "release:minor": "node scripts/release.js minor",
    "release:major": "node scripts/release.js major"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maojindao55/deepseek-harness-acp.git"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "acp",
    "agent-client-protocol",
    "ai-agent",
    "streaming",
    "reasoning"
  ],
  "author": "maojindao55 <hobby0524@gmail.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-acp": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-app-boot": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-base": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-agent": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-llm": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-session": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-session-query": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-attachment": "0.1.6-alpha.2",
    "@deepseek-ai/schemastery": "3.18.2",
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.1.6-alpha.2",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
